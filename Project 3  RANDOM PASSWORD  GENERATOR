import string
import secrets
import math
import json
import os
from datetime import datetime

# PDF Generation Imports
from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

# ── Character Pool Constants ──────────────────────────────────
LOWERCASE  = string.ascii_lowercase
UPPERCASE  = string.ascii_uppercase
DIGITS     = string.digits
SYMBOLS    = string.punctuation

# ── Security & Policy Guidelines ──────────────────────────────
MIN_LENGTH       = 8
RECOMMENDED_MIN = 15
MAX_LENGTH       = 64
DATA_FILE        = "password_history.json"


# ── Persistence Helpers ───────────────────────────────────────

def load_history():
    """Load saved password records safely without crashing if file missing/corrupt."""
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
    return []

def save_history(history):
    """Serialize password history gracefully."""
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f, indent=4)
    except Exception as e:
        print(f"  ⚠️ Note: Could not save history to disk ({e}). Proceeding in-memory.")


# ── PDF Exporter Engine ───────────────────────────────────────

def generate_pdf_report(passwords_data, filename="password_report.pdf"):
    """Generate a clean, professional PDF security report."""
    doc = SimpleDocTemplate(filename, pagesize=letter, leftMargin=36, rightMargin=36, topMargin=36, bottomMargin=36)
    styles = getSampleStyleSheet()
    story = []

    # Custom Paragraph Styles
    title_style = ParagraphStyle('DocTitle', parent=styles['Heading1'], fontSize=18, textColor=colors.HexColor('#1E293B'), spaceAfter=4)
    subtitle_style = ParagraphStyle('SubTitle', parent=styles['Normal'], fontSize=10, textColor=colors.HexColor('#64748B'), spaceAfter=15)
    pass_style = ParagraphStyle('PassStyle', parent=styles['Code'], fontSize=13, textColor=colors.HexColor('#0F172A'), backColor=colors.HexColor('#F1F5F9'), alignment=1, spaceBefore=4, spaceAfter=4)
    body_style = ParagraphStyle('Body', parent=styles['Normal'], fontSize=9, textColor=colors.HexColor('#334155'))
    bold_style = ParagraphStyle('BoldBody', parent=styles['Normal'], fontSize=9, fontName="Helvetica-Bold", textColor=colors.HexColor('#0F172A'))

    # Header
    story.append(Paragraph("DecodeLabs Security Report", title_style))
    story.append(Paragraph(f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')} | NIST SP 800-63-4 Guidelines", subtitle_style))
    story.append(Spacer(1, 10))

    # Table Data Formulation
    table_data = [
        [Paragraph("<b>#</b>", bold_style), 
         Paragraph("<b>Generated Password</b>", bold_style), 
         Paragraph("<b>Length</b>", bold_style), 
         Paragraph("<b>Entropy</b>", bold_style), 
         Paragraph("<b>Crack Time</b>", bold_style)]
    ]

    for idx, item in enumerate(passwords_data, start=1):
        table_data.append([
            Paragraph(str(idx), body_style),
            Paragraph(f"<b>{item['password']}</b>", pass_style),
            Paragraph(f"{item['length']} chars", body_style),
            Paragraph(f"{item['entropy']} bits", body_style),
            Paragraph(item['crack_time'], body_style)
        ])

    pdf_table = Table(table_data, colWidths=[25, 200, 75, 75, 140])
    pdf_table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor('#E2E8F0')),
        ('TEXTCOLOR', (0, 0), (-1, 0), colors.HexColor('#0F172A')),
        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
        ('BOTTOMPADDING', (0, 0), (-1, -1), 8),
        ('TOPPADDING', (0, 0), (-1, -1), 8),
        ('GRID', (0, 0), (-1, -1), 0.5, colors.HexColor('#CBD5E1')),
    ]))

    story.append(pdf_table)
    story.append(Spacer(1, 20))
    story.append(Paragraph("Confidential & Cryptographically Secure Document — DecodeLabs", subtitle_style))

    try:
        doc.build(story)
        print(f"\n  📄 PDF Security Report created successfully: [ {filename} ]")
    except Exception as e:
        print(f"\n  ⚠️ Failed to generate PDF: {e}")


# ── Phase 1: Input & Validation ───────────────────────────────

def get_password_length():
    """Validate user input for password length."""
    while True:
        try:
            raw_input = input("  📏 Enter password length (8–64) [default: 16]: ").strip()
            if not raw_input:
                return 16
            length = int(raw_input)
            if length < MIN_LENGTH:
                print(f"  ⚠️ Minimum length is {MIN_LENGTH}. Try again.")
            elif length > MAX_LENGTH:
                print(f"  ⚠️ Maximum length is {MAX_LENGTH}. Try again.")
            else:
                if length < RECOMMENDED_MIN:
                    print(f"  ⚠️ NIST recommendation is {RECOMMENDED_MIN}+ chars. Proceeding...")
                return length
        except ValueError:
            print("  ⚠️ Please enter a valid integer.")

def get_character_options():
    """Prompt user for character set customization."""
    print("\n  🔧 Customize character sets (Press Enter to accept defaults [Yes]):")

    def ask(prompt):
        choice = input(f"  {prompt} [Y/n]: ").strip().lower()
        return choice != 'n'

    use_upper   = ask("Include UPPERCASE letters? (A-Z)")
    use_lower   = ask("Include lowercase letters? (a-z)")
    use_digits  = ask("Include DIGITS?            (0-9)")
    use_symbols = ask("Include SYMBOLS?           (!@#$...)")

    if not any([use_upper, use_lower, use_digits, use_symbols]):
        print("  ⚠️ At least one type required. Enabling all sets by default.")
        return True, True, True, True

    return use_upper, use_lower, use_digits, use_symbols

def get_quantity():
    """Prompt user for number of passwords to generate."""
    while True:
        try:
            raw_input = input("  🔢 How many passwords to generate? (1–10) [default: 1]: ").strip()
            if not raw_input:
                return 1
            n = int(raw_input)
            if 1 <= n <= 10:
                return n
            print("  ⚠️ Enter a number between 1 and 10.")
        except ValueError:
            print("  ⚠️ Please enter a valid integer.")


# ── Phase 2: Core Password Generation Engine ──────────────────

def generate_password(length, pool, base_guaranteed):
    """Generates a cryptographically secure random password."""
    guaranteed = [secrets.choice(subset) for subset in base_guaranteed]
    remaining_length = length - len(guaranteed)
    remaining_chars = [secrets.choice(pool) for _ in range(remaining_length)]
    
    all_chars = guaranteed + remaining_chars
    secrets.SystemRandom().shuffle(all_chars)
    return ''.join(all_chars)


# ── Phase 3: Analytics & Reporting ───────────────────────────

def calculate_entropy(length, pool_size):
    """Calculate dynamic Shannon entropy (E = L * log2(R))."""
    if pool_size <= 1:
        return 0.0
    return round(length * math.log2(pool_size), 2)

def get_strength_label(entropy):
    """Map entropy bits to strength metrics."""
    if entropy < 28:   return "❌ VERY WEAK   — Insecure"
    if entropy < 36:   return "🟠 WEAK        — High vulnerability"
    if entropy < 60:   return "🟡 MODERATE    — Acceptable for basic use"
    if entropy < 80:   return "🟢 STRONG      — Recommended"
    if entropy < 100:  return "💪 VERY STRONG — Highly Secure"
    return "🔒 UNBREAKABLE — Enterprise Grade"

def get_crack_time(entropy):
    """Estimate brute-force cracking time at 10 Billion attempts/sec."""
    guesses_per_sec = 10_000_000_000
    combinations = 2 ** entropy
    seconds = combinations / guesses_per_sec

    if seconds < 60:         return f"{seconds:.1f} seconds"
    if seconds < 3600:       return f"{seconds/60:.1f} minutes"
    if seconds < 86400:      return f"{seconds/3600:.1f} hours"
    if seconds < 31536000:   return f"{seconds/86400:.1f} days"
    if seconds < 3.15e10:    return f"{seconds/31536000:.1f} years"
    return "Millions of years 🔒"

def display_password_report(password, pool_size, index=1):
    """Print complete analytical report for a single password."""
    length = len(password)
    entropy = calculate_entropy(length, pool_size)
    label = get_strength_label(entropy)
    crack = get_crack_time(entropy)

    print(f"\n  {'─'*47}")
    print(f"  🔑 Password #{index}")
    print(f"  {'─'*47}")
    print(f"  {password}")
    print(f"  {'─'*47}")
    print(f"  📏 Length       : {length} characters")
    print(f"  🎯 Pool Size    : {pool_size} unique characters")
    print(f"  📊 Entropy      : {entropy} bits")
    print(f"  🛡️ Strength     : {label}")
    print(f"  ⏱️ Crack Time   : {crack} (@ 10B guesses/sec)")


# ── System Control & Flow ─────────────────────────────────────

def view_history(history):
    """Output historical generations stored in system context."""
    print("\n" + "═" * 52)
    print("   📜 PASSWORD GENERATION HISTORY")
    print("═" * 52)

    if not history:
        print("  No prior generation records found.")
        print("═" * 52)
        return

    for record in history[-10:]:
        print(f"  [{record['date']}]  Length: {record['length']:2d} | "
              f"Entropy: {record['entropy']:6.2f} bits | "
              f"Strength: {record['strength']}")
    print("═" * 52)

def generate_flow(history):
    """Workflow execution handling configuration through generation."""
    print("\n" + "─" * 52)
    print("  ⚙️ CONFIGURE GENERATOR PARAMETERS")
    print("─" * 52)

    length = get_password_length()
    use_upper, use_lower, use_digits, use_symbols = get_character_options()
    quantity = get_quantity()

    character_subsets = []
    pool = ""
    if use_upper:
        pool += UPPERCASE
        character_subsets.append(UPPERCASE)
    if use_lower:
        pool += LOWERCASE
        character_subsets.append(LOWERCASE)
    if use_digits:
        pool += DIGITS
        character_subsets.append(DIGITS)
    if use_symbols:
        pool += SYMBOLS
        character_subsets.append(SYMBOLS)

    pool_size = len(set(pool))

    print("\n" + "═" * 52)
    print(f"  🚀 Generating {quantity} password(s)...")
    print("═" * 52)

    pdf_batch = []
    for i in range(1, quantity + 1):
        password = generate_password(length, pool, character_subsets)
        entropy = calculate_entropy(length, pool_size)
        crack_time = get_crack_time(entropy)
        
        display_password_report(password, pool_size, index=i)

        history.append({
            "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "length": length,
            "entropy": entropy,
            "strength": get_strength_label(entropy).split("—")[0].strip(),
            "pool": pool_size
        })

        pdf_batch.append({
            "password": password,
            "length": length,
            "entropy": entropy,
            "crack_time": crack_time
        })

    save_history(history)
    print("\n  ✅ Generation complete.")

    export_pdf = input("\n  📄 Would you like to export these results to a PDF report? [Y/n]: ").strip().lower()
    if export_pdf != 'n':
        generate_pdf_report(pdf_batch)

def main():
    """Main execution loop."""
    print("\n  Welcome to Enterprise Password Generator 🔐")
    history = load_history()

    while True:
        print("\n" + "═" * 52)
        print("    🔐 DecodeLabs Password Security Suite")
        print("═" * 52)
        print("    1. 🔑 Generate Password(s)")
        print("    2. 📜 View History")
        print("    3. 🚪 Exit")
        print("─" * 52)
        
        try:
            choice = input("    Choose an option (1-3): ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\n\n  👋 Session ended safely.\n")
            break

        if choice == "1":
            generate_flow(history)
        elif choice == "2":
            view_history(history)
        elif choice == "3":
            print("\n  👋 Stay secure!\n")
            break
        else:
            print("\n  ⚠️ Invalid option. Please select 1, 2, or 3.")

if __name__ == "__main__":
    main()
